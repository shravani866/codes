#include<stdio.h>
int main() {
    int N,M;
    scanf("%d %d",&N,&M);
    int matrix[M];
    int col_sums [M];
    for(int i=0;i<M;i++) {
        col_sums[i]=0;
    }
    for(int i=0;i<N;i++) {
        for(int j=0;j<M;j++) { scanf("%d",&matrix[i][j]); col_sums[j]+=matrix[i][j];
        }
    }
    for(int i=0;i<M;i++) {
        printf("%d",col_sums[i]);
        if(i!=M-1)
            printf(" ");
    }
    printf("\n");
    return 0;
}
