#include<stdio.h>
int main()
{
    int N;
    scanf("%d",&N);
    int arr;
    for(int i=0;i<N;i++) {
        scanf("%d",&arr[i]);
    }
    int A,B;
    scanf("%d %d",&A,&B);
    int found=0;
    for(int i=0;i<N;i++) {
        if(arr[i]<A||arr[i]>B) {
            printf("%d ",arr[i]);
            found=1;
        }
    }
    if(found) {
        printf("-1");
    }
    return 0;
}
