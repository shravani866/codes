#include<stdio.h>
int main() {
    double stats[8];
    for(int i=0;i<8;i++) {
        scanf("%lf",&stats[i]);
    }
    double balls=stats[2];
    double runs=stats[3];
    double wickets=stats[4];
    double average=runs/wickets;
    double strikeRate=balls/wickets;
    int overs_int=(int)(balls/6);
    int remaining_balls=(int)(balls)%6;
    double overs=overs_int+(remaining_balls/10.0);
    double economy=runs/overs;
    printf("%.2f\n",average);
    printf("%.2f\n",strikeRate);
    printf("%.2f\n",economy);
    return 0;
}
