#include<stdio.h>
int main() {
int N,M;
scanf("%d %d", &N,&M);
int matrix[M];
int even_sum=0,odd_sum=0;
for(int i=0 ;i<N;i++) {
for(int j=0;j<M;j++) {
scanf("%d",&matrix[i][j]);
if(matrix[i][j]%2==0)
even_sum+=matrix[i][j];
else
odd_sum+=matrix[i][j];
}
}
printf("%d %d
",even_sum, odd_sum);
return 0;
}
